{
  "name": "dsh-jingjing-sticky-notes",
  "version": "1.7.0",
  "description": "把对话中的回复、选区或整段对话收藏为本地 Markdown 便签，并在右侧栏随时查看、对比与插回输入框。",
  "license": "MIT",
  "author": "tryqylz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryqylz/dsh-jingjing-sticky-notes.git"
  },
  "homepage": "https://github.com/tryqylz/dsh-jingjing-sticky-notes#readme",
  "bugs": {
    "url": "https://github.com/tryqylz/dsh-jingjing-sticky-notes/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./lib/typert.host.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sticky-notes",
    "markdown",
    "notes",
    "sidebar"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
